<?xml version="1.0" encoding="utf-8"?>
<ApplicationPackage SchemaVersion="1.0"
                    AppVersion="1.0.0"
                    Name="TPL - Batch Plotter"
                    Description="AutoCAD Batch Plotting Plugin - Hỗ trợ in hàng loạt layout"
                    Author="Tam Hoang"
                    ProductCode="{FFD5CCD5-C23C-4A59-8016-6437F3B2346B}">

  <CompanyDetails Name="Tam Hoang" Email="" />

  <Components>
    <!-- Nhóm 1: AutoCAD 2015 - 2024 (.NET Framework 4.8) -->
    <RuntimeRequirements OS="Win64" Platform="AutoCAD" SeriesMin="R20.0" SeriesMax="R24.3" />
    <ComponentEntry AppName="TPL"
                    Version="1.0"
                    ModuleName="./Contents/v2021-2024/TPL.dll"
                    AppDescription="AutoCAD Batch Plotting Plugin (.NET Framework 4.8)"
                    LoadOnCommandInvocation="True"
                    LoadOnAutoCADStartup="True">
      <Commands GroupName="TPL_COMMANDS">
        <Command Global="TPL" Local="TPL" />
        <Command Global="TPL_LICENSE" Local="TPL_LICENSE" />
      </Commands>
    </ComponentEntry>
  </Components>

  <Components>
    <!-- Nhóm 2: AutoCAD 2025 - 2026+ (.NET 8.0 Core) -->
    <RuntimeRequirements OS="Win64" Platform="AutoCAD" SeriesMin="R25.0" SeriesMax="R26.1" />
    <ComponentEntry AppName="TPL"
                    Version="1.0"
                    ModuleName="./Contents/v2025-2026/TPL.dll"
                    AppDescription="AutoCAD Batch Plotting Plugin (.NET 8.0)"
                    LoadOnCommandInvocation="True"
                    LoadOnAutoCADStartup="True">
      <Commands GroupName="TPL_COMMANDS">
        <Command Global="TPL" Local="TPL" />
        <Command Global="TPL_LICENSE" Local="TPL_LICENSE" />
      </Commands>
    </ComponentEntry>
  </Components>
</ApplicationPackage>
