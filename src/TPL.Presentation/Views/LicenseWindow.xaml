<Window x:Class="TPL.Presentation.Views.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="License Manager - TPL"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="#181A1F"
        AllowsTransparency="False"
        ShowInTaskbar="True"
        ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TPL.Presentation;component/Resources/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="260"/>
            </Grid.RowDefinitions>

            <!-- TITLE BAR -->
            <Border Grid.Row="0" Background="#12141A" CornerRadius="10,10,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Border Width="22" Height="22" CornerRadius="5" Background="{StaticResource AccentBrush}" Margin="0,0,10,0">
                            <TextBlock Text="L" Foreground="White" FontWeight="Bold" FontSize="13" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                        </Border>
                        <TextBlock Text="License Manager — TPL" 
                                   Foreground="{StaticResource FgBrush}" FontSize="13" FontWeight="SemiBold" 
                                   VerticalAlignment="Center" FontFamily="Segoe UI"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0">
                        <Button Content="✕" Width="36" Height="28" 
                                Style="{StaticResource DangerButton}" Padding="0" FontSize="11"
                                Click="BtnClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CONTENT -->
            <StackPanel Grid.Row="1" Margin="20,15,20,20">
                <TextBlock x:Name="lblStatus" Text="{Binding StatusMessage}" 
                           Foreground="{Binding StatusColor}"
                           FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                           TextWrapping="Wrap" Margin="0,0,0,20"/>

                <TextBlock Text="Hardware ID:" Foreground="{StaticResource FgBrush}" 
                           FontSize="12" FontFamily="Segoe UI" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtHwId" Grid.Column="0" IsReadOnly="True" 
                             Text="{Binding HardwareId, Mode=OneWay}"
                             Style="{StaticResource DarkTextBox}"/>
                    <Button Grid.Column="1" Content="📋 Copy" Style="{StaticResource DarkButton}" 
                            Margin="8,0,0,0" Width="80" Click="BtnCopy_Click"/>
                </Grid>

                <TextBlock Text="License Key:" Foreground="{StaticResource FgBrush}" 
                           FontSize="12" FontFamily="Segoe UI" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtKey" Grid.Column="0" 
                             Text="{Binding ActivationKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DarkTextBox}" Margin="0,0,10,0"/>
                    <Button Grid.Column="1" Content="Activate" Style="{StaticResource AccentButton}" 
                            Width="80" Click="BtnActivate_Click" FontSize="11"/>
                </Grid>

                <!-- Activation Message -->
                <TextBlock x:Name="lblActivationMsg" Text="{Binding ActivationMessage}" 
                           Foreground="{StaticResource LabelBrush}" FontSize="11" FontFamily="Segoe UI"
                           TextWrapping="Wrap" Margin="0,0,0,15"/>

                <!-- Footer -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Close" Style="{StaticResource DarkButton}" 
                            Width="90" Height="34" Click="BtnClose_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
