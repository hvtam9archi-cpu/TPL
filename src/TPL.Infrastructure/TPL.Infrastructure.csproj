<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <AssemblyName>TPL.Infrastructure</AssemblyName>
    <RootNamespace>TPL.Infrastructure</RootNamespace>
    <UseWindowsForms>false</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TPL.Core\TPL.Core.csproj" />
    <ProjectReference Include="..\TPL.Domain\TPL.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- AutoCAD .NET API — ExcludeAssets=runtime to avoid copying CAD DLLs -->
    <PackageReference Include="AutoCAD.NET" Version="23.1.0" ExcludeAssets="runtime" />
    <PackageReference Include="AutoCAD.NET.Core" Version="23.1.0" ExcludeAssets="runtime" />
    <PackageReference Include="AutoCAD.NET.Model" Version="23.1.0" ExcludeAssets="runtime" />
    <!-- License: hardware ID via WMI -->
    <PackageReference Include="System.Management" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
  </ItemGroup>
</Project>
