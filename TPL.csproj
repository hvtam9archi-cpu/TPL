<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <LangVersion>10.0</LangVersion>
    <AssemblyName>TPL</AssemblyName>
    <RootNamespace>TPL</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <Platforms>AnyCPU;x64</Platforms>
    <!-- AutoCAD is a 64-bit host; keep the plugin architecture aligned with its API assemblies. -->
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <!-- Generated deployment and installer files must not participate in assembly resolution. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts\**;Output\**;**\bin\**;**\obj\**</DefaultItemExcludes>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EnableBundleDeploy Condition="'$(EnableBundleDeploy)' == ''">true</EnableBundleDeploy>
    <BundleDeployRoot Condition="'$(BundleDeployRoot)' == ''">$(AppData)\Autodesk\ApplicationPlugins\TPL.bundle</BundleDeployRoot>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="AutoCAD.NET" Version="23.1.0" ExcludeAssets="runtime" />
    <PackageReference Include="AutoCAD.NET.Core" Version="23.1.0" ExcludeAssets="runtime" />
    <PackageReference Include="AutoCAD.NET.Model" Version="23.1.0" ExcludeAssets="runtime" />
    <!-- v1.50 has a native .NET Framework assembly and no System.Memory dependency chain. -->
    <PackageReference Include="PDFsharp" Version="1.50.5147" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="AutoCAD.NET" Version="25.0.1" ExcludeAssets="runtime" />
    <PackageReference Include="AutoCAD.NET.Core" Version="25.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="AutoCAD.NET.Model" Version="25.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="PDFsharp" Version="6.1.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep the established renderer until an equivalent stable .NET 8 WinForms renderer is available. -->
    <PackageReference Include="PdfiumViewer" Version="2.13.0" NoWarn="NU1701" />
    <PackageReference Include="PdfiumViewer.Native.x86_64.v8-xfa" Version="2018.4.8.256" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resource\StyleSettings_32px.ico" />
    <Resource Include="Resource\IconRotate_32px.png" />
    <Resource Include="Resource\IconRotate_32px.ico" />
    <EmbeddedResource Include="Resource\IconRibbon_32px.png" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <!-- Post-build: Tự động deploy vào ApplicationPlugins -->
  <Target Name="DeployBundle" AfterTargets="Build"
          Condition="'$(EnableBundleDeploy)' == 'true' and '$(IsCrossTargetingBuild)' != 'true' and '$(TargetFramework)' != ''">
    <!-- Xác định thư mục con dựa trên TargetFramework -->
    <PropertyGroup>
      <DeployFolderName Condition="'$(TargetFramework)' == 'net48'">v2021-2024</DeployFolderName>
      <DeployFolderName Condition="'$(TargetFramework)' == 'net8.0-windows'">v2025-2026</DeployFolderName>
      <BundleContentsPath>$(BundleDeployRoot)\Contents\$(DeployFolderName)</BundleContentsPath>
    </PropertyGroup>
    <Error Condition="'$(DeployFolderName)' == ''" Text="No bundle folder is defined for $(TargetFramework)." />
    <ItemGroup>
      <!-- Preserve native/resource subfolders and the .NET dependency manifest. -->
      <BundleOutputFiles Include="$(TargetDir)**\*"
                         Exclude="$(TargetDir)AcMgd.dll;$(TargetDir)AcDbMgd.dll;$(TargetDir)AcCoreMgd.dll;$(TargetDir)AdWindows.dll" />
      <BundleDestinationFiles Include="@(BundleOutputFiles->'$(BundleContentsPath)\%(RecursiveDir)%(Filename)%(Extension)')" />
      <!-- Remove obsolete files only inside this framework's TPL contents folder. -->
      <ObsoleteBundleFiles Include="$(BundleContentsPath)\**\*" Exclude="@(BundleDestinationFiles)" />
    </ItemGroup>
    <MakeDir Directories="$(BundleContentsPath)" />
    <Copy SourceFiles="@(BundleOutputFiles)" DestinationFiles="@(BundleDestinationFiles)" SkipUnchangedFiles="true" />
    <Delete Files="@(ObsoleteBundleFiles)" />
    <Copy SourceFiles="$(ProjectDir)TPL.bundle\PackageContents.xml" DestinationFolder="$(BundleDeployRoot)" SkipUnchangedFiles="true" />
  </Target>
</Project>


