<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <AssemblyName>TPL</AssemblyName>
    <RootNamespace>TPL</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <Platforms>AnyCPU;x64</Platforms>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <!-- Có thể ghi đè bằng: dotnet build -p:VinaCadSdkDir="..." -->
    <VinaCadSdkDir Condition="'$(VinaCadSdkDir)' == ''">$(ProgramFiles)\VinaCAD\VinaCAD 2026</VinaCadSdkDir>
    <DeployBundleEnabled Condition="'$(DeployBundleEnabled)' == ''">false</DeployBundleEnabled>
    <AdditionalLibPaths>$(VinaCadSdkDir)</AdditionalLibPaths>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="TD_Mgd_Net8_26.12_17">
      <HintPath>$(VinaCadSdkDir)\TD_Mgd_Net8_26.12_17.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="VinaCADCoreMgd_Net8">
      <HintPath>$(VinaCadSdkDir)\VinaCADCoreMgd_Net8.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="TakaUI">
      <HintPath>$(VinaCadSdkDir)\TakaUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PdfiumViewer" Version="2.13.0" />
    <PackageReference Include="PdfiumViewer.Native.x86_64.v8-xfa" Version="2018.4.8.256" />
    <PackageReference Include="PDFsharp" Version="6.1.1" />
    <PackageReference Include="System.Management" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resource\StyleSettings_32px.ico" />
    <Resource Include="Resource\IconRotate_32px.png" />
    <Resource Include="Resource\IconRotate_32px.ico" />
    <EmbeddedResource Include="Resource\IconRibbon_32px.png" />
    <EmbeddedResource Include="Resource\IconRibbon_License_32px.png" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <!-- Post-build: tự động deploy vào thư mục autoload của VinaCAD -->
  <Target Name="DeployBundle" AfterTargets="Build" Condition="'$(DeployBundleEnabled)' == 'true'">
    <PropertyGroup>
      <DeployFolderName>v2025-2026</DeployFolderName>
    </PropertyGroup>
    <!-- Tạo thư mục bundle nếu chưa có -->
    <MakeDir Directories="$(AppData)\VinaCAD\ApplicationPlugins\TPL.bundle\Contents\$(DeployFolderName)" />
    <!-- Copy tất cả các file DLL (bao gồm cả thư viện) vào Contents\$(DeployFolderName) -->
    <Copy SourceFiles="@(ReferenceCopyLocalPaths)" DestinationFolder="$(AppData)\VinaCAD\ApplicationPlugins\TPL.bundle\Contents\$(DeployFolderName)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(AppData)\VinaCAD\ApplicationPlugins\TPL.bundle\Contents\$(DeployFolderName)" SkipUnchangedFiles="false" />
    <!-- Copy PackageContents.xml vào bundle root -->
    <Copy SourceFiles="$(ProjectDir)TPL.bundle\PackageContents.xml" DestinationFolder="$(AppData)\VinaCAD\ApplicationPlugins\TPL.bundle" SkipUnchangedFiles="false" />
    <!-- Copy pdfium.dll (Native) -->
    <MakeDir Directories="$(AppData)\VinaCAD\ApplicationPlugins\TPL.bundle\Contents\$(DeployFolderName)\x64" />
    <Copy SourceFiles="$(TargetDir)x64\pdfium.dll" DestinationFolder="$(AppData)\VinaCAD\ApplicationPlugins\TPL.bundle\Contents\$(DeployFolderName)\x64" SkipUnchangedFiles="false" Condition="Exists('$(TargetDir)x64\pdfium.dll')" />
  </Target>
</Project>
