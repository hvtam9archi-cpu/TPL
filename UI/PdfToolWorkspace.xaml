<UserControl x:Class="TPL.PdfToolWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
             Background="#181A1F"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <SolidColorBrush x:Key="ToolForeground" Color="#E8EAED"/>
        <SolidColorBrush x:Key="ToolSecondary" Color="#8A93A1"/>
        <SolidColorBrush x:Key="ToolSurface" Color="#22262D"/>
        <SolidColorBrush x:Key="ToolSurfaceRaised" Color="#2B2D32"/>
        <SolidColorBrush x:Key="ToolBorder" Color="#333640"/>
        <SolidColorBrush x:Key="ToolAccent" Color="#2563EB"/>

        <Style x:Key="ToolPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ToolSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ToolBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="ToolInput" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Foreground" Value="{StaticResource ToolForeground}"/>
            <Setter Property="Background" Value="#1D2026"/>
            <Setter Property="BorderBrush" Value="{StaticResource ToolBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource ToolAccent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="13,5"/>
            <Setter Property="Foreground" Value="{StaticResource ToolForeground}"/>
            <Setter Property="Background" Value="{StaticResource ToolSurfaceRaised}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ToolBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#3A3D45"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#4B5563"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#444750"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolAccentButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource ToolAccent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ToolAccent}"/>
        </Style>

        <Style x:Key="ToolDangerButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Foreground" Value="#FCA5A5"/>
            <Setter Property="Background" Value="#3B1C1C"/>
            <Setter Property="BorderBrush" Value="#5C2D2D"/>
        </Style>

        <Style x:Key="ToolSectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ToolForeground}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="ToolLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ToolSecondary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,12,0,5"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="44"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#12141A" BorderBrush="{StaticResource ToolBorder}" BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource ToolButton}"
                        Width="82" Height="32" Padding="8,4"
                        Content="←  Tools"
                        Click="Back_Click"/>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="txtToolTitle" Foreground="{StaticResource ToolForeground}" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtToolDescription" Margin="0,3,0,0" Foreground="{StaticResource ToolSecondary}" FontSize="11.5"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="toolContentHost" Grid.Row="1" Margin="18,14,18,12">
            <!-- Merge PDF: ordered multi-file queue and one output. -->
            <Grid x:Name="mergePanel" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource ToolPanel}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="PDF files" Style="{StaticResource ToolSectionTitle}" Margin="0"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Add files" Style="{StaticResource ToolButton}" Width="82" Click="MergeAdd_Click"/>
                                    <Button Content="Remove" Style="{StaticResource ToolDangerButton}" Width="74" Margin="6,0,0,0" Click="MergeRemove_Click"/>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Text="The files are merged from top to bottom." Foreground="{StaticResource ToolSecondary}" FontSize="11" Margin="0,0,0,8"/>
                        </StackPanel>
                        <ListBox x:Name="lstMergeFiles"
                                 Background="#1D2026" Foreground="{StaticResource ToolForeground}"
                                 BorderBrush="{StaticResource ToolBorder}" BorderThickness="1"
                                 Padding="4"/>
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource ToolPanel}">
                    <StackPanel>
                        <TextBlock Text="Merge settings" Style="{StaticResource ToolSectionTitle}"/>
                        <TextBlock Text="Change file order" Style="{StaticResource ToolLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Move up" Style="{StaticResource ToolButton}" Width="88" Click="MergeUp_Click"/>
                            <Button Content="Move down" Style="{StaticResource ToolButton}" Width="94" Margin="7,0,0,0" Click="MergeDown_Click"/>
                        </StackPanel>
                        <TextBlock Text="Output PDF" Style="{StaticResource ToolLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="txtMergeOutput" Style="{StaticResource ToolInput}"/>
                            <Button Grid.Column="1" Content="Browse" Style="{StaticResource ToolButton}" Width="72" Margin="7,0,0,0" Click="MergeOutput_Click"/>
                        </Grid>
                        <Button Content="Merge PDF files" Style="{StaticResource ToolAccentButton}" Height="40" Margin="0,22,0,0" Click="MergeRun_Click"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Split PDF: one input, split mode, folder output. -->
            <Grid x:Name="splitPanel" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource ToolPanel}">
                    <StackPanel>
                        <TextBlock Text="Source document" Style="{StaticResource ToolSectionTitle}"/>
                        <TextBlock Text="Input PDF" Style="{StaticResource ToolLabel}" Margin="0,4,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="txtSplitInput" Style="{StaticResource ToolInput}" IsReadOnly="True"/>
                            <Button Grid.Column="1" Content="Open" Style="{StaticResource ToolButton}" Width="70" Margin="7,0,0,0" Click="SplitInput_Click"/>
                        </Grid>
                        <TextBlock x:Name="txtSplitPageCount" Text="No PDF selected" Foreground="{StaticResource ToolSecondary}" Margin="0,8,0,0"/>
                        <TextBlock Text="Split mode" Style="{StaticResource ToolLabel}"/>
                        <RadioButton x:Name="rbSplitEveryPage" Content="Create one PDF for every page" IsChecked="True" Foreground="{StaticResource ToolForeground}" Margin="0,4"/>
                        <RadioButton x:Name="rbSplitRanges" Content="Create one PDF for each range below" Foreground="{StaticResource ToolForeground}" Margin="0,4"/>
                        <TextBlock Text="Ranges - example: 1-3, 4-6, 8" Style="{StaticResource ToolLabel}"/>
                        <TextBox x:Name="txtSplitRanges" Style="{StaticResource ToolInput}" Text="1-3, 4-6"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource ToolPanel}">
                    <StackPanel>
                        <TextBlock Text="Output" Style="{StaticResource ToolSectionTitle}"/>
                        <TextBlock Text="Destination folder" Style="{StaticResource ToolLabel}" Margin="0,4,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="txtSplitOutputFolder" Style="{StaticResource ToolInput}" IsReadOnly="True"/>
                            <Button Grid.Column="1" Content="Browse" Style="{StaticResource ToolButton}" Width="72" Margin="7,0,0,0" Click="SplitOutput_Click"/>
                        </Grid>
                        <Border Margin="0,18,0,0" Padding="12" Background="#1D2026" CornerRadius="6">
                            <TextBlock Text="Each generated file keeps the original page dimensions and orientation." Foreground="{StaticResource ToolSecondary}" TextWrapping="Wrap"/>
                        </Border>
                        <Button Content="Split PDF" Style="{StaticResource ToolAccentButton}" Height="40" Margin="0,22,0,0" Click="SplitRun_Click"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- PDF Viewer: dedicated navigation and preview only. -->
            <Grid x:Name="viewPanel" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource ToolPanel}" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="PDF file" Foreground="{StaticResource ToolSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="txtViewInput" Grid.Column="1" Style="{StaticResource ToolInput}" IsReadOnly="True"/>
                        <Button Grid.Column="2" Content="Open PDF" Style="{StaticResource ToolAccentButton}" Width="88" Margin="8,0,0,0" Click="ViewInput_Click"/>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Margin="0,10" Background="#20242B" BorderBrush="{StaticResource ToolBorder}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                    <Grid>
                        <wfi:WindowsFormsHost x:Name="viewPdfHost" Visibility="Collapsed"/>
                        <TextBlock x:Name="txtViewPlaceholder" Text="Open a PDF to start reading" Foreground="{StaticResource ToolSecondary}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource ToolPanel}" Padding="10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="btnViewPrevious" Content="Previous" Style="{StaticResource ToolButton}" Width="86" Click="ViewPrevious_Click"/>
                        <TextBlock x:Name="txtViewPage" Text="Page 0 / 0" Foreground="{StaticResource ToolForeground}" Width="120" TextAlignment="Center" VerticalAlignment="Center"/>
                        <Button x:Name="btnViewNext" Content="Next" Style="{StaticResource ToolButton}" Width="86" Click="ViewNext_Click"/>
                        <Button Content="Zoom out" Style="{StaticResource ToolButton}" Width="82" Margin="18,0,0,0" Click="ViewZoomOut_Click"/>
                        <Button Content="Zoom in" Style="{StaticResource ToolButton}" Width="78" Margin="6,0,0,0" Click="ViewZoomIn_Click"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Rotate PDF: range + direction + output. -->
            <Grid x:Name="rotatePanel" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource ToolPanel}">
                    <StackPanel>
                        <TextBlock Text="Pages to rotate" Style="{StaticResource ToolSectionTitle}"/>
                        <TextBlock Text="Input PDF" Style="{StaticResource ToolLabel}" Margin="0,4,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="txtRotateInput" Style="{StaticResource ToolInput}" IsReadOnly="True"/>
                            <Button Grid.Column="1" Content="Open" Style="{StaticResource ToolButton}" Width="70" Margin="7,0,0,0" Click="RotateInput_Click"/>
                        </Grid>
                        <TextBlock x:Name="txtRotatePageCount" Text="No PDF selected" Foreground="{StaticResource ToolSecondary}" Margin="0,8,0,0"/>
                        <TextBlock Text="Page ranges - leave blank for all pages" Style="{StaticResource ToolLabel}"/>
                        <TextBox x:Name="txtRotateRanges" Style="{StaticResource ToolInput}"/>
                        <TextBlock Text="Examples: 1, 3-5, 8" Foreground="{StaticResource ToolSecondary}" FontSize="10.5" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource ToolPanel}">
                    <StackPanel>
                        <TextBlock Text="Rotation and output" Style="{StaticResource ToolSectionTitle}"/>
                        <TextBlock Text="Output PDF" Style="{StaticResource ToolLabel}" Margin="0,4,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="txtRotateOutput" Style="{StaticResource ToolInput}"/>
                            <Button Grid.Column="1" Content="Browse" Style="{StaticResource ToolButton}" Width="72" Margin="7,0,0,0" Click="RotateOutput_Click"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                            <Button Content="↶  Rotate left" Style="{StaticResource ToolAccentButton}" Height="42" Width="132" Click="RotateLeftRun_Click"/>
                            <Button Content="Rotate right  ↷" Style="{StaticResource ToolAccentButton}" Height="42" Width="132" Margin="8,0,0,0" Click="RotateRightRun_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Remove PDF pages: destructive selection but new output file. -->
            <Grid x:Name="removePanel" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource ToolPanel}">
                    <StackPanel>
                        <TextBlock Text="Remove pages" Style="{StaticResource ToolSectionTitle}"/>
                        <TextBlock Text="Input PDF" Style="{StaticResource ToolLabel}" Margin="0,4,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="txtRemoveInput" Style="{StaticResource ToolInput}" IsReadOnly="True"/>
                            <Button Grid.Column="1" Content="Open" Style="{StaticResource ToolButton}" Width="70" Margin="7,0,0,0" Click="RemoveInput_Click"/>
                        </Grid>
                        <TextBlock x:Name="txtRemovePageCount" Text="No PDF selected" Foreground="{StaticResource ToolSecondary}" Margin="0,8,0,0"/>
                        <TextBlock Text="Pages to remove" Style="{StaticResource ToolLabel}"/>
                        <TextBox x:Name="txtRemoveRanges" Style="{StaticResource ToolInput}"/>
                        <TextBlock Text="Example: 2, 5-7. At least one page must remain." Foreground="{StaticResource ToolSecondary}" FontSize="10.5" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource ToolPanel}">
                    <StackPanel>
                        <TextBlock Text="Save cleaned document" Style="{StaticResource ToolSectionTitle}"/>
                        <TextBlock Text="Output PDF" Style="{StaticResource ToolLabel}" Margin="0,4,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="txtRemoveOutput" Style="{StaticResource ToolInput}"/>
                            <Button Grid.Column="1" Content="Browse" Style="{StaticResource ToolButton}" Width="72" Margin="7,0,0,0" Click="RemoveOutput_Click"/>
                        </Grid>
                        <Button Content="Remove selected pages" Style="{StaticResource ToolDangerButton}" Height="42" Margin="0,22,0,0" Click="RemoveRun_Click"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Extract PDF pages: one range selection into one output. -->
            <Grid x:Name="extractPanel" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource ToolPanel}">
                    <StackPanel>
                        <TextBlock Text="Extract page selection" Style="{StaticResource ToolSectionTitle}"/>
                        <TextBlock Text="Input PDF" Style="{StaticResource ToolLabel}" Margin="0,4,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="txtExtractInput" Style="{StaticResource ToolInput}" IsReadOnly="True"/>
                            <Button Grid.Column="1" Content="Open" Style="{StaticResource ToolButton}" Width="70" Margin="7,0,0,0" Click="ExtractInput_Click"/>
                        </Grid>
                        <TextBlock x:Name="txtExtractPageCount" Text="No PDF selected" Foreground="{StaticResource ToolSecondary}" Margin="0,8,0,0"/>
                        <TextBlock Text="Pages to extract" Style="{StaticResource ToolLabel}"/>
                        <TextBox x:Name="txtExtractRanges" Style="{StaticResource ToolInput}"/>
                        <TextBlock Text="The selected pages are written in the order entered." Foreground="{StaticResource ToolSecondary}" FontSize="10.5" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource ToolPanel}">
                    <StackPanel>
                        <TextBlock Text="Extracted PDF" Style="{StaticResource ToolSectionTitle}"/>
                        <TextBlock Text="Output PDF" Style="{StaticResource ToolLabel}" Margin="0,4,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="txtExtractOutput" Style="{StaticResource ToolInput}"/>
                            <Button Grid.Column="1" Content="Browse" Style="{StaticResource ToolButton}" Width="72" Margin="7,0,0,0" Click="ExtractOutput_Click"/>
                        </Grid>
                        <Button Content="Extract pages" Style="{StaticResource ToolAccentButton}" Height="42" Margin="0,22,0,0" Click="ExtractRun_Click"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Rearrange PDF: dedicated ordered page list. -->
            <Grid x:Name="rearrangePanel" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource ToolPanel}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Page order" Style="{StaticResource ToolSectionTitle}" Margin="0"/>
                                    <TextBlock x:Name="txtRearrangeInput" Text="No PDF selected" Foreground="{StaticResource ToolSecondary}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Open PDF" Style="{StaticResource ToolButton}" Width="86" Click="RearrangeInput_Click"/>
                            </Grid>
                        </StackPanel>
                        <ListBox x:Name="lstRearrangePages"
                                 Background="#1D2026" Foreground="{StaticResource ToolForeground}"
                                 BorderBrush="{StaticResource ToolBorder}" BorderThickness="1"
                                 Padding="4"/>
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource ToolPanel}">
                    <StackPanel>
                        <TextBlock Text="Reorder and save" Style="{StaticResource ToolSectionTitle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="Move up" Style="{StaticResource ToolButton}" Width="88" Click="RearrangeUp_Click"/>
                            <Button Content="Move down" Style="{StaticResource ToolButton}" Width="94" Margin="7,0,0,0" Click="RearrangeDown_Click"/>
                        </StackPanel>
                        <TextBlock Text="Output PDF" Style="{StaticResource ToolLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="txtRearrangeOutput" Style="{StaticResource ToolInput}"/>
                            <Button Grid.Column="1" Content="Browse" Style="{StaticResource ToolButton}" Width="72" Margin="7,0,0,0" Click="RearrangeOutput_Click"/>
                        </Grid>
                        <Button Content="Save new page order" Style="{StaticResource ToolAccentButton}" Height="42" Margin="0,22,0,0" Click="RearrangeRun_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#12141A" BorderBrush="{StaticResource ToolBorder}" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="txtToolStatus" Text="Ready" Foreground="{StaticResource ToolSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <ProgressBar x:Name="toolProgress" Grid.Column="1" Height="8" Minimum="0" Maximum="100" Visibility="Collapsed" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
