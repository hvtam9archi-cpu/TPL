<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="TPL.PdfEditorWindow"
        xmlns:local="clr-namespace:TPL"
        Title="PDF Editor - TPL"
        Width="1100" Height="650"
        MinWidth="940" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="#181A1F"
        AllowsTransparency="False"
        ShowInTaskbar="True"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        ResizeMode="CanResizeWithGrip">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- ─── Color Palette ─── -->
        <Color x:Key="BgColor">#181A1F</Color>
        <Color x:Key="SurfaceColor">#2B2D32</Color>
        <Color x:Key="BorderColor">#333640</Color>
        <Color x:Key="ThumbColor">#3A3D45</Color>
        <Color x:Key="TrackColor">#1A1C21</Color>
        <Color x:Key="FgColor">#E8EAED</Color>
        <Color x:Key="LabelColor">#6B7280</Color>
        <Color x:Key="AccentColor">#2563EB</Color>
        <Color x:Key="AccentDarkColor">#1D4ED8</Color>
        <Color x:Key="DangerColor">#EF4444</Color>
        <Color x:Key="SuccessColor">#22C55E</Color>

        <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="ThumbBrush" Color="{StaticResource ThumbColor}"/>
        <SolidColorBrush x:Key="TrackBrush" Color="{StaticResource TrackColor}"/>
        <SolidColorBrush x:Key="FgBrush" Color="{StaticResource FgColor}"/>
        <SolidColorBrush x:Key="LabelBrush" Color="{StaticResource LabelColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}"/>
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>

        <!-- ─── Custom Scrollbar (VS Code style, 8px thin) ─── -->
        <Style x:Key="ScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Background="{StaticResource ThumbBrush}" 
                                CornerRadius="4" 
                                Margin="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarPageButton" TargetType="{x:Type RepeatButton}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Rectangle Fill="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="VerticalScrollBar" TargetType="{x:Type ScrollBar}">
            <Grid>
                <Border Background="{StaticResource TrackBrush}" CornerRadius="4"/>
                <Track x:Name="PART_Track" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="ScrollBar.PageUpCommand"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource ScrollBarThumb}"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="ScrollBar.PageDownCommand"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="14"/>
                    <Setter Property="Height" Value="Auto"/>
                    <Setter Property="Template" Value="{StaticResource VerticalScrollBar}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ─── Button Styles ─── -->
        <Style x:Key="AccentButton" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                Background="{StaticResource AccentBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkButton" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                Background="{StaticResource SurfaceBrush}" 
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource ThumbBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#44474F"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="{x:Type Button}" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                Background="#3B1C1C" BorderBrush="#5C2D2D" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4B2222"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#5C2D2D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style x:Key="ZoomComboBox" TargetType="{x:Type ComboBox}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
            <Setter Property="Background" Value="{StaticResource BgBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="MaxDropDownHeight" Value="240"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type ComboBoxItem}">
                        <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                        <Setter Property="Padding" Value="8,5"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                                    <Border x:Name="ItemBorder"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}"
                                            Margin="2,1" CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource ThumbBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="ItemBorder" Property="Opacity" Value="0.45"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Grid>
                                    <ContentPresenter x:Name="ContentSite"
                                                      Margin="8,0,27,0"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                                    <Path x:Name="DropDownArrow"
                                          Width="8" Height="5" Margin="0,0,9,0"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Data="M 0 0 L 4 4 L 8 0 Z"
                                          Fill="{StaticResource LabelBrush}"
                                          IsHitTestVisible="False"/>
                                    <ToggleButton x:Name="DropDownToggle"
                                                  Focusable="False" ClickMode="Press"
                                                  Background="Transparent" BorderThickness="0"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom" PlacementTarget="{Binding ElementName=ComboBorder}"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, ElementName=ComboBorder}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,3,0,0" Padding="2"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="6">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder" Property="Background" Value="{StaticResource ThumbBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="DropDownArrow" Property="Fill" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ─── TextBox Style ─── -->
        <Style x:Key="DarkTextBox" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource FgBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ─── GridViewColumnHeader Style ─── -->
        <Style TargetType="{x:Type GridViewColumnHeader}">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource LabelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource ThumbBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource BgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ─── ListView Item (PDF Page row) ─── -->
        <Style x:Key="PdfPageItemStyle" TargetType="{x:Type ListViewItem}">
            <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                        <Border x:Name="Bd" Background="{Binding RowBackgroundColorBrush}" 
                                BorderBrush="Transparent" BorderThickness="1.5" 
                                CornerRadius="4" Padding="4,4" Margin="2,1">
                            <GridViewRowPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Selected: gradient border + blended accent/group background -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#60A5FA" Offset="0.0"/>
                                            <GradientStop Color="#C084FC" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Bd" Property="Background" Value="{Binding SelectedBackgroundBrush}"/>
                            </Trigger>
                            <!-- Hover (not selected): brighter group tint -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{Binding HoverBackgroundBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#20FFFFFF"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ─── Main Window Border ─── -->
    <Border Background="{StaticResource BgBrush}" 
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            ClipToBounds="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Title bar -->
                <RowDefinition Height="40"/>
                <!-- Document command bar -->
                <RowDefinition Height="*"/>
                <!-- Content -->
                <RowDefinition Height="Auto"/>
                <!-- Progress bar -->
                <RowDefinition Height="Auto"/>
                <!-- Bottom bar -->
            </Grid.RowDefinitions>

            <!-- ═══ TITLE BAR (draggable) ═══ -->
            <Border Grid.Row="0" Background="#12141A" CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: App icon + title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Border Width="22" Height="22" CornerRadius="5" Background="{StaticResource AccentBrush}" Margin="0,0,10,0">
                            <TextBlock Text="P" Foreground="White" FontWeight="Bold" FontSize="13" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                        </Border>
                        <TextBlock x:Name="txtTitle" Text="PDF Editor — TPL" 
                                   Foreground="{StaticResource FgBrush}" FontSize="13" FontWeight="SemiBold" 
                                   VerticalAlignment="Center" FontFamily="Segoe UI"/>
                    </StackPanel>

                    <!-- Right: Window controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Button x:Name="btnMinimize" Content="─" Width="36" Height="28" 
                            Style="{StaticResource DarkButton}" Padding="0" FontSize="12"
                            Click="BtnMinimize_Click" BorderThickness="0"/>
                        <Button x:Name="btnMaximize" Width="36" Height="28"
                                Style="{StaticResource DarkButton}" Padding="0"
                                Click="BtnMaximize_Click" BorderThickness="0" Margin="5,0,0,0"
                                ToolTip="Maximize">
                            <Grid Width="14" Height="12" SnapsToDevicePixels="True">
                                <!-- Maximized icon: one window -->
                                <Path x:Name="iconMaximize" Data="M 1,1 H 13 V 11 H 1 Z"
                                      Stroke="{StaticResource FgBrush}" StrokeThickness="1.3"
                                      StrokeLineJoin="Miter" Fill="Transparent"/>

                                <!-- Windowed icon: two overlapping windows -->
                                <Grid x:Name="iconWindowed" Visibility="Collapsed">
                                    <Path Data="M 4,1 H 13 V 9 H 10 V 4 H 4 Z"
                                          Stroke="{StaticResource FgBrush}" StrokeThickness="1.2"
                                          StrokeLineJoin="Miter" Fill="Transparent"/>
                                    <Path Data="M 1,4 H 10 V 12 H 1 Z"
                                          Stroke="{StaticResource FgBrush}" StrokeThickness="1.3"
                                          StrokeLineJoin="Miter" Fill="{StaticResource SurfaceBrush}"/>
                                </Grid>
                            </Grid>
                        </Button>
                        <Button x:Name="btnClose" Content="✕" Width="36" Height="28" 
                            Style="{StaticResource DangerButton}" Padding="0" FontSize="11"
                            Click="BtnClose_Click" BorderThickness="0" Margin="5,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="documentCommandBar" Grid.Row="1" Height="40" Visibility="Collapsed" Background="#12141A"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1"
                    Padding="10,5">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="btnHome" Content="Tools" Style="{StaticResource DarkButton}"
                            Height="28" MinWidth="58" Padding="10,3" Margin="0,0,10,0" Click="BtnHome_Click" ToolTip="Back to PDF tools"/>
                    <Button x:Name="btnNew" Content="New" Style="{StaticResource DarkButton}"
                            Height="28" MinWidth="54" Padding="10,3" Click="BtnNew_Click" ToolTip="New (Ctrl+N)"/>
                    <Button x:Name="btnOpen" Content="Open" Style="{StaticResource DarkButton}"
                            Height="28" MinWidth="58" Padding="10,3" Margin="5,0,0,0" Click="BtnOpen_Click" ToolTip="Open PDF (Ctrl+O)"/>
                    <Button x:Name="btnSaveCommand" Content="Save" Style="{StaticResource AccentButton}"
                            Height="28" MinWidth="58" Padding="10,3" Margin="5,0,0,0" Click="BtnSaveCommand_Click" ToolTip="Save (Ctrl+S)"/>
                    <Button x:Name="btnSaveAs" Content="Save As" Style="{StaticResource DarkButton}"
                            Height="28" MinWidth="72" Padding="10,3" Margin="5,0,10,0" Click="BtnSaveAs_Click" ToolTip="Save As (Ctrl+Shift+S)"/>
                    <Button x:Name="btnUndo" Content="Undo" Style="{StaticResource DarkButton}"
                            Height="28" MinWidth="58" Padding="10,3" IsEnabled="False" Click="BtnUndo_Click" ToolTip="Undo (Ctrl+Z)"/>
                    <Button x:Name="btnRedo" Content="Redo" Style="{StaticResource DarkButton}"
                            Height="28" MinWidth="58" Padding="10,3" Margin="5,0,10,0" IsEnabled="False" Click="BtnRedo_Click" ToolTip="Redo (Ctrl+Y)"/>
                    <Button x:Name="btnDuplicate" Content="Duplicate" Style="{StaticResource DarkButton}"
                            Height="28" MinWidth="76" Padding="10,3" Click="BtnDuplicate_Click" ToolTip="Duplicate selected pages (Ctrl+D)"/>
                    <Button x:Name="btnRotateLeft" Content="Rotate Left" Style="{StaticResource DarkButton}"
                            Height="28" MinWidth="84" Padding="10,3" Margin="5,0,0,0" Click="BtnRotateLeft_Click"/>
                    <Button x:Name="btnRotateRight" Content="Rotate Right" Style="{StaticResource DarkButton}"
                            Height="28" MinWidth="90" Padding="10,3" Margin="5,0,0,0" Click="BtnRotateRight_Click"/>
                    <Button x:Name="btnExtract" Content="Extract" Style="{StaticResource DarkButton}"
                            Height="28" MinWidth="66" Padding="10,3" Margin="10,0,0,0" Click="BtnExtract_Click" ToolTip="Export selected pages (Ctrl+E)"/>
                </StackPanel>
            </Border>

            <!-- ═══ PDF TOOL DASHBOARD ═══ -->
            <local:PdfToolsDashboard x:Name="toolsDashboard"
                                     Grid.Row="2"
                                     ToolSelected="ToolsDashboard_ToolSelected"/>

            <local:PdfToolWorkspace x:Name="specializedToolWorkspace"
                                    Grid.Row="1" Grid.RowSpan="4"
                                    Visibility="Collapsed"
                                    BackRequested="SpecializedToolWorkspace_BackRequested"/>

            <!-- ═══ EDITOR CONTENT ═══ -->
            <Grid x:Name="editorWorkspace" Grid.Row="2" Margin="14,10,14,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" MinWidth="300"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ─── LEFT PANEL: Toolbar + Page List ─── -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Toolbar -->
                        <RowDefinition Height="*"/>
                        <!-- List -->
                    </Grid.RowDefinitions>

                    <!-- Toolbar: 2 rows, fixed layout -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,6">
                        <!-- Row 1: Import and page expansion option -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4" Height="30">
                            <Button x:Name="btnAdd" Content="Import" 
                                    Style="{StaticResource DarkButton}" FontSize="11" FontWeight="Bold"
                                    Width="100" Height="26" Padding="0" Click="BtnAdd_Click" Margin="0,0,6,0">
                                <Button.BorderBrush>
                                    <SolidColorBrush Color="{DynamicResource TrackColor}"/>
                                </Button.BorderBrush>
                                <Button.Foreground>
                                    <SolidColorBrush Color="{DynamicResource SuccessColor}"/>
                                </Button.Foreground>
                                <Button.Background>
                                    <SolidColorBrush Color="{DynamicResource BorderColor}"/>
                                </Button.Background>
                            </Button>
                            <CheckBox x:Name="chkSeparatePdfs" Content="Import as pages" IsChecked="True"
                                      Foreground="{StaticResource LabelBrush}" 
                                      VerticalAlignment="Center" FontSize="11" Margin="0"/>
                        </StackPanel>
                        <!-- Row 2: Remove, Up, Down, Rotate -->
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="btnRemove" Content="Remove" 
                                    Style="{StaticResource DangerButton}" FontSize="11" FontWeight="Bold"
                                    Width="100" Height="26" Padding="0" Click="BtnRemove_Click" Margin="0,0,6,0"/>
                            <Button x:Name="btnUp" Content="▲" 
                                    Style="{StaticResource DarkButton}" FontSize="11"
                                    Width="34" Height="26" Padding="0" Click="BtnUp_Click" Margin="0,0,3,0"/>
                            <Button x:Name="btnDown" Content="▼" 
                                    Style="{StaticResource DarkButton}" FontSize="11"
                                    Width="34" Height="26" Padding="0" Click="BtnDown_Click" Margin="0"/>
                            <Button x:Name="btnRotate" 
                                    Style="{StaticResource DarkButton}" 
                                    Width="34" Height="26" Padding="0" Click="BtnRotate_Click" Margin="3,0,0,0" ToolTip="Rotate Clockwise">
                                <Image Source="pack://application:,,,/TPL.PdfEditor;component/Resource/IconRotate_32px.png" Width="14" Height="14" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- PDF Page List with STT column -->
                    <ListView x:Name="lstPages" Grid.Row="1"
                              Background="{StaticResource SurfaceBrush}" 
                              BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                              Foreground="{StaticResource FgBrush}"
                              SelectionMode="Extended"
                              AllowDrop="True"
                              SelectionChanged="LstPages_SelectionChanged"
                              PreviewMouseLeftButtonDown="LstPages_PreviewMouseLeftButtonDown"
                              PreviewMouseLeftButtonUp="LstPages_PreviewMouseLeftButtonUp"
                              PreviewMouseMove="LstPages_PreviewMouseMove"
                              DragOver="LstPages_DragOver"
                              DragLeave="LstPages_DragLeave"
                              Drop="LstPages_Drop"
                              SizeChanged="LstPages_SizeChanged"
                              ItemContainerStyle="{StaticResource PdfPageItemStyle}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=5}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="#" Width="Auto" 
                                                DisplayMemberBinding="{Binding SequenceNumber}"/>
                                <GridViewColumn Header="" Width="0">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="10" Height="18" CornerRadius="3"
                                                    Background="{Binding GroupColorBrush}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Source" Width="Auto">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="3" Padding="4,1" HorizontalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="{x:Type Border}">
                                                        <Setter Property="Background" Value="#1A2563EB"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SourceLabel}" Value="File">
                                                                <Setter Property="Background" Value="#1A22C55E"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding SourceLabel}" FontSize="9" 
                                                           FontWeight="SemiBold" HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="{x:Type TextBlock}">
                                                            <Setter Property="Foreground" Value="#60A5FA"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SourceLabel}" Value="File">
                                                                    <Setter Property="Foreground" Value="#4ADE80"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Page" Width="180">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       TextWrapping="Wrap" TextTrimming="None"
                                                       Margin="0,2"
                                                       ToolTip="{Binding DisplayName}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>

                <!-- Separator -->
                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"
                              ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                              Background="Transparent">
                    <GridSplitter.Template>
                        <ControlTemplate TargetType="{x:Type GridSplitter}">
                            <Border Background="Transparent">
                                <Border Width="2" HorizontalAlignment="Center"
                                        Background="{StaticResource BorderBrush}"/>
                            </Border>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>

                <!-- ─── RIGHT PANEL: PDF Preview ─── -->
                <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" 
                        CornerRadius="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Preview zoom toolbar -->
                        <Border Grid.Row="0" Background="#12141A"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                Padding="10,4">
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="Preview" Foreground="{StaticResource LabelBrush}"
                                           FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI"
                                           VerticalAlignment="Center"/>

                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="btnZoomOut" Style="{StaticResource DarkButton}"
                                            Width="32" Height="28" Padding="0" IsEnabled="False"
                                            Click="BtnZoomOut_Click" ToolTip="Zoom out">
                                        <Grid Width="18" Height="18" SnapsToDevicePixels="True">
                                            <Ellipse Width="10" Height="10" Margin="1,1,0,0"
                                                     HorizontalAlignment="Left" VerticalAlignment="Top"
                                                     Stroke="{StaticResource FgBrush}" StrokeThickness="1.6"/>
                                            <Line X1="9" Y1="9" X2="16" Y2="16"
                                                  Stroke="{StaticResource FgBrush}" StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            <Line X1="3.5" Y1="6" X2="8.5" Y2="6"
                                                  Stroke="{StaticResource FgBrush}" StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Grid>
                                    </Button>

                                    <ComboBox x:Name="cmbZoomPercent" Style="{StaticResource ZoomComboBox}"
                                              Width="76" Margin="5,0" IsEnabled="False"
                                              SelectionChanged="CmbZoomPercent_SelectionChanged"
                                              ToolTip="Select zoom level">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StringFormat={}{0}%}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <Button x:Name="btnZoomIn" Style="{StaticResource DarkButton}"
                                            Width="32" Height="28" Padding="0" IsEnabled="False"
                                            Click="BtnZoomIn_Click" ToolTip="Zoom in">
                                        <Grid Width="18" Height="18" SnapsToDevicePixels="True">
                                            <Ellipse Width="10" Height="10" Margin="1,1,0,0"
                                                     HorizontalAlignment="Left" VerticalAlignment="Top"
                                                     Stroke="{StaticResource FgBrush}" StrokeThickness="1.6"/>
                                            <Line X1="9" Y1="9" X2="16" Y2="16"
                                                  Stroke="{StaticResource FgBrush}" StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            <Line X1="3.5" Y1="6" X2="8.5" Y2="6"
                                                  Stroke="{StaticResource FgBrush}" StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            <Line X1="6" Y1="3.5" X2="6" Y2="8.5"
                                                  Stroke="{StaticResource FgBrush}" StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Grid Grid.Row="1">
                            <WindowsFormsHost x:Name="pdfHost" Margin="0" Visibility="Collapsed"/>
                            <!-- Placeholder when no page selected -->
                            <TextBlock x:Name="txtNoPreview" Text="Select a page to preview"
                                       Foreground="{StaticResource LabelBrush}" FontSize="14" FontFamily="Segoe UI"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Visible"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══ PROGRESS BAR (hidden by default) ═══ -->
            <local:DarkProgressControl x:Name="pnlProgress" Grid.Row="3" Visibility="Collapsed" Margin="14,10,14,0"/>

            <!-- ═══ BOTTOM BAR ═══ -->
            <Border x:Name="editorFooter" Grid.Row="4" Visibility="Collapsed" Background="#12141A" Padding="14,10" CornerRadius="0,0,10,10">
                <DockPanel>
                    <!-- Right side: Save / Cancel -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="btnSave" Content="💾  Save File" 
                                Style="{StaticResource AccentButton}" 
                                Width="140" Height="36" FontSize="13"
                                Click="BtnSave_Click" BorderBrush="#00000000" Margin="0,4,0,0"/>
                        <Button x:Name="btnCancel" Content="Close"
                                Style="{StaticResource DarkButton}" 
                                Width="100" Height="36" Margin="8,4,0,0"
                                Click="BtnCancel_Click"/>
                    </StackPanel>
                    <!-- Left side: File name (fills remaining space) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="File Name" Foreground="{StaticResource LabelBrush}" 
                            FontSize="10" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="txtFileName" Style="{StaticResource DarkTextBox}" 
                            Width="251" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtDocumentStatus" Text="0 pages" Foreground="{StaticResource LabelBrush}"
                                   FontSize="11" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="14,0,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
